{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Teams Meeting Controls",
	"Version": "0.2.0.24",
	"Author": "Laurens Bolle",
	"Actions": [
		{
			"Name": "Reaction",
			"UUID": "com.laurens-bolle.teams-reactions.reaction",
			"Icon": "imgs/actions/like/icon",
			"Tooltip": "Send the reaction chosen in the key settings.",
			"PropertyInspectorPath": "ui/reaction.html",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/like/key",
					"Title": "Reaction",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Like",
			"UUID": "com.laurens-bolle.teams-reactions.like",
			"Icon": "imgs/actions/like/icon",
			"Tooltip": "Send a Like reaction.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/like/key",
					"Title": "Like",
					"ShowTitle": false
				}
			],
			"VisibleInActionsList": false
		},
		{
			"Name": "Love",
			"UUID": "com.laurens-bolle.teams-reactions.love",
			"Icon": "imgs/actions/love/icon",
			"Tooltip": "Send a Love reaction.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/love/key",
					"Title": "Love",
					"ShowTitle": false
				}
			],
			"VisibleInActionsList": false
		},
		{
			"Name": "Applause",
			"UUID": "com.laurens-bolle.teams-reactions.applause",
			"Icon": "imgs/actions/applause/icon",
			"Tooltip": "Send an Applause reaction.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/applause/key",
					"Title": "Applause",
					"ShowTitle": false
				}
			],
			"VisibleInActionsList": false
		},
		{
			"Name": "Laugh",
			"UUID": "com.laurens-bolle.teams-reactions.laugh",
			"Icon": "imgs/actions/laugh/icon",
			"Tooltip": "Send a Laugh reaction.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/laugh/key",
					"Title": "Laugh",
					"ShowTitle": false
				}
			],
			"VisibleInActionsList": false
		},
		{
			"Name": "Surprise",
			"UUID": "com.laurens-bolle.teams-reactions.surprise",
			"Icon": "imgs/actions/surprise/icon",
			"Tooltip": "Send a Surprise reaction.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/surprise/key",
					"Title": "Surprise",
					"ShowTitle": false
				}
			],
			"VisibleInActionsList": false
		},
		{
			"Name": "Mute",
			"UUID": "com.laurens-bolle.teams-reactions.mute",
			"Icon": "imgs/actions/mute/icon",
			"Tooltip": "Mute or unmute the active Microsoft Teams meeting.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/mute/unmuted",
					"Title": "Unmuted",
					"ShowTitle": false
				},
				{
					"Image": "imgs/actions/mute/muted",
					"Title": "Muted",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Push to Talk",
			"UUID": "com.laurens-bolle.teams-reactions.push-to-talk",
			"Icon": "imgs/actions/push-to-talk/icon",
			"Tooltip": "Hold to unmute; release to mute again.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/push-to-talk/unmuted",
					"Title": "Talking",
					"ShowTitle": false
				},
				{
					"Image": "imgs/actions/push-to-talk/muted",
					"Title": "Muted",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Camera",
			"UUID": "com.laurens-bolle.teams-reactions.camera",
			"Icon": "imgs/actions/camera/icon",
			"Tooltip": "Turn the camera on or off in the active Microsoft Teams meeting.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/camera/on",
					"Title": "Camera on",
					"ShowTitle": false
				},
				{
					"Image": "imgs/actions/camera/off",
					"Title": "Camera off",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Background Blur",
			"UUID": "com.laurens-bolle.teams-reactions.blur",
			"Icon": "imgs/actions/blur/icon",
			"Tooltip": "Turn background blur on or off in the active Microsoft Teams meeting.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/blur/on",
					"Title": "Blur on",
					"ShowTitle": false
				},
				{
					"Image": "imgs/actions/blur/off",
					"Title": "Blur off",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Raise Hand",
			"UUID": "com.laurens-bolle.teams-reactions.hand",
			"Icon": "imgs/actions/hand/icon",
			"Tooltip": "Raise or lower your hand in the active Microsoft Teams meeting.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/hand/lowered",
					"Title": "Hand lowered",
					"ShowTitle": false
				},
				{
					"Image": "imgs/actions/hand/raised",
					"Title": "Hand raised",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Share Screen",
			"UUID": "com.laurens-bolle.teams-reactions.share",
			"Icon": "imgs/actions/share/icon",
			"Tooltip": "Open the Microsoft Teams share picker, or stop sharing if you are sharing. You choose what to share in Teams.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/share/off",
					"Title": "Not sharing",
					"ShowTitle": false
				},
				{
					"Image": "imgs/actions/share/on",
					"Title": "Sharing",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Leave Call",
			"UUID": "com.laurens-bolle.teams-reactions.leave",
			"Icon": "imgs/actions/leave/icon",
			"Tooltip": "Hold for 1.5 seconds to leave the active Microsoft Teams meeting without ending it for everyone. A tap does nothing.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/leave/leave",
					"Title": "Leave",
					"ShowTitle": false
				}
			]
		}
	],
	"Category": "Teams Meeting Controls",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Control Microsoft Teams meetings and send reactions from Stream Deck on macOS.",
	"Icon": "imgs/plugin/marketplace",
	"ApplicationsToMonitor": {
		"mac": [
			"com.microsoft.teams2"
		]
	},
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "13"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.laurens-bolle.teams-reactions"
}